{
  "name": "atools",
  "version": "1.0.1",
  "private": true,
  "description": "Turn audio into a spectrogram and back: a browser-only sound ↔ image converter with a MoonBit DSP kernel",
  "license": "GPL-3.0-only",
  "author": {
    "name": "烧风 HK-SHAO",
    "email": "hk-shao@outlook.com",
    "url": "https://space.bilibili.com/24046148"
  },
  "homepage": "https://atools.shao.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HK-SHAO/atools.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --hot app/index.ts",
    "build:web": "bun scripts/build.ts",
    "build:wasm": "cd moon && moon build --release --deny-warn --target wasm",
    "deploy": "bun scripts/build.ts && bunx wrangler deploy --config cloudflare/wrangler.jsonc",
    "typecheck": "tsc -b",
    "test": "bun test",
    "check": "bun typecheck && bun lint && bun test && bun test:kernel && bun build:web",
    "test:kernel": "cd moon && moon test --release --deny-warn --target wasm",
    "compare:librosa": "bun bench/librosa.ts",
    "compare:librosa:stft": "${PYTHON:-python3} bench/librosa_stft.py",
    "compare:librosa:phase": "bun bench/librosa_phase.ts",
    "compare:librosa:phase-perf": "${PYTHON:-python3} bench/librosa_phase_perf.py",
    "moon:ports": "cd moon && moon check --deny-warn --target js && moon check --deny-warn --target native",
    "moon:fmt": "cd moon && moon fmt --check",
    "bench:kernel": "cd moon && moon bench --release --deny-warn --target wasm",
    "bench:kernel:native": "cd moon && moon bench --release --deny-warn --target native",
    "bench:kernel:build": "cd moon && moon bench --release --deny-warn --target wasm --build-only",
    "bench:moonebench": "bun bench/moonebench.ts",
    "quality": "bun bench/quality.ts",
    "kernel": "bun bench/kernel.ts",
    "offline": "bun bench/offline.ts",
    "ui": "bun bench/ui.ts",
    "perf": "bun bench/perf.ts",
    "bench": "bun bench/run.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@audio/decode-aac": "^1.5.0",
    "@audio/decode-amr": "^1.3.1",
    "@audio/decode-flac": "^1.3.3",
    "@audio/decode-mp3": "^1.3.1",
    "@audio/decode-opus": "^1.3.1",
    "@audio/decode-vorbis": "^1.3.2",
    "@audio/decode-wav": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  }
}
