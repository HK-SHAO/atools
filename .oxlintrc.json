{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // `Bun.build`'s `reactCompiler` already rewrites components at compile time, and this group is
    // that compiler's own list of reasons to step back: a pattern it cannot recognise is silently
    // left unoptimised, and silence is the hardest regression to notice. Running the compiler's
    // internal checks here too makes "not optimised" visible instead of a guess.
    "react/hooks": "error",
    "react/purity": "error",
    "react/immutability": "error",
    "react/globals": "error",
    "react/static-components": "error",
    "react/set-state-in-render": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // These four were once deliberate deviations (cancelling an in-flight job inside an effect and
    // resetting derived state), kept at warn so they stayed visible. Those places now derive: a
    // result is stored with the spec it belongs to, the range draft with the parameters, the
    // playback state with the timeline, so no effect calls setState and not one case is left in the
    // repository. They are pinned at error like the rest. A real deviation gets an inline
    // `// oxlint-disable-next-line <rule>` next to the reason.
    "react/set-state-in-effect": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/memo-dependencies": "error",

    // `react/refs` reads `ref={job.ref}` in JSX as touching a ref value during render, and takes
    // `spec` / `audio` / `png` on the same elements down with it. Here `ref` is a format field (the
    // reference samples of the source, see docs/format-spec.md), not a React ref, and renaming it
    // would change the file format.
    "react/refs": "off",

    // Classic JSX runtime only; this project uses `jsx: "react-jsx"`, the automatic runtime where
    // React need not be in scope.
    "react/react-in-jsx-scope": "off",

    // Style rules, and these run against the choices made here:
    "unicorn/consistent-function-scoping": "off", // asks whether a function can move out of its parent scope, never whether it should
    "unicorn/prefer-add-event-listener": "off", // `node.onended = fn` wants exactly one handler
    "unicorn/require-post-message-target-origin": "off", // the target is a Worker, so there is no origin argument
    "unicorn/no-array-sort": "off" // the flagged calls sort arrays that filter or a fresh literal just produced
  },
  "ignorePatterns": ["dist", "node_modules", ".local", "moon/_build", "bench/bundle*.js"]
}
