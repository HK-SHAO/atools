/**
 * Pure static assets deployment: no Worker source, no main, no bindings.
 * assets.directory points at ../dist, produced by `bun run build:web` in the repository root and resolved relative to this file.
 * The pattern follows the shaofeng repository's cloudflare workspace (commit 3138ea7).
 */
{
	"name": "atools",
	"compatibility_date": "2026-09-09",
	"assets": {
		"directory": "../dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	// The build emits no .map files; if sourcemaps were ever enabled, true would upload the source publicly, so it is explicitly off
	"upload_source_maps": false
}
