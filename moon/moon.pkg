// 宿主（JS）直调的数值库：无 _start、零 import，导出面即全部接口。
// 内存契约、缓冲上限与降级路径写在 session.mbt 顶部。
pkgtype(kind: "foreign_library")

supported_targets = "wasm"

import {
  "moonbitlang/core/math",
  "moonbitlang/core/v128",
}

import {
  "moonbitlang/core/bench",
} for "wbtest"

// 导出面用 #export_name 逐函数在源码内标注（名字贴着实现）。
// alert_experimental 是刻意接受的：热循环要用 @v128 的双精度运算内建（见 fft.mbt 的 last_stage），
// 它们标着实验性且没有替代品。其余警告一律照显。
options(
  warn_list: "-alert_experimental",
  link: {
    "wasm": {
      "export-memory-name": "memory",
    },
  },
)
