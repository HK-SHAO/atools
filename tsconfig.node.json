{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // 构建期与评测台跑在 Bun 上（`package.json` 的脚本全是 `bun ...`），所以这里给
    // node + bun 两套全局；`app/` 一分都拿不到，那条边界正是拆工程的用意。
    "target": "es2023",
    // DOM 是给 `bench/entry.ts` 的：那是**页面侧**的评测台入口（由 Vite 打包、在 CDP 打开的
    // 标签页里跑），driver 侧再从它取 `Row` 类型，于是 app/ 的浏览器代码被传递地拖进来。
    // 这几件东西本来就要在一个工程里，只是它们同时用到 Bun 与 DOM。
    "lib": ["ES2023", "DOM"],
    "types": ["node", "bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // vite.config.ts 显式 import "./scripts/moon.ts"，带扩展名是这里的既定写法
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  // app 的 `.d.ts` 单独收进来：`app/lib/audio-meta.d.ts` 是环境声明（没被谁按路径 import），
  // 传递依赖带不出它，不收就等于那几个 `@audio/decode-*/meta` 全部无类型。
  "include": ["vite.config.ts", "scripts", "bench", "app/**/*.d.ts"]
}
